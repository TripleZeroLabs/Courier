{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Courier",
  "version": "1.0.0",
  "identifier": "dev.personal.courier",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["settings"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Triple Zero Labs LLC",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "../tools/sign.ps1", "%1"]
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
